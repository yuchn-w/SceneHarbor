+
+// Called once per completed offscreen frame, never from UI redraw notifications.
+void EmitRenderStatistics(AppState* state, std::uint32_t width, std::uint32_t height) {
+    const auto now = std::chrono::steady_clock::now();
+    if (state->last_frame_at.time_since_epoch().count() == 0 ||
+        std::chrono::duration<double>(now - state->last_frame_at).count() > 3.0) {
+        state->stats_started_at = now;
+        state->stats_frames = 0;
+    }
+    state->last_frame_at = now;
+    const double elapsed = std::chrono::duration<double>(now - state->stats_started_at).count();
+    if (elapsed <= 0) return;
+    ++state->stats_frames;
+    if (elapsed < 1.0) return;
+    const double fps = state->stats_frames / elapsed;
+    state->stats_started_at = now;
+    state->stats_frames = 0;
+    std::lock_guard lock(LifecycleOutputMutex());
+    std::cout << "{\"event\":\"render-stats\",\"fps\":" << fps
+              << ",\"width\":" << width << ",\"height\":" << height << "}\n" << std::flush;
 }
 
